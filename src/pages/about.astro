---
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import avatar from '@/assets/images/avatar.jpeg';
import { Image } from 'astro:assets';
---

<BaseLayout seo={{
  title: 'About — Joel Amoako',
  description: 'AI & Software Engineer and consultant based in Accra, Ghana. Building AI-powered software, workflow automation, and scalable backend systems.',
  type: 'profile',
}}>
  <Container as="section" class="py-6">
    <div class="flex flex-col gap-10 max-w-2xl">

      <div class="flex items-center gap-5">
        <Image src={avatar} alt="Joel Amoako" width={80} height={80} class="rounded-full" />
        <div>
          <h1 class="text-3xl font-semibold text-headings">Joel Amoako</h1>
          <p class="text-muted-foreground text-xl">AI & Software Engineer</p>
        </div>
      </div>

      <div class="flex flex-col gap-4 text-xl leading-relaxed">
        <p>
          I'm a software engineer and AI consultant based in Accra, Ghana. I build AI-powered software,
          workflow automation, and scalable backend systems for businesses — helping teams move faster
          without breaking things.
        </p>
        <p>
          My day job is at <a href="https://pawapay.io" class="text-headings underline underline-offset-4">pawaPay</a>,
          where I work on backend infrastructure for mobile money payments across Africa.
          Outside of that, I run <a href="https://cycaslabs.com" class="text-headings underline underline-offset-4">Cycas Labs</a>,
          a software consultancy where I help companies integrate AI into their products and workflows.
        </p>
        <p>
          I write mostly in Go, Python, and TypeScript. I'm big on open source — some of my projects
          have picked up hundreds of GitHub stars, including <a href="https://docs.easyjitsi.com" class="text-headings underline underline-offset-4">Easy Jitsi</a>,
          a documentation site I built during the 2020 video conferencing surge.
        </p>
        <p>
          This site is my corner of the internet — writing, projects, and a record of things I've built.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold text-headings">Get in touch</h2>
        <div class="flex flex-col gap-1 text-xl text-muted-foreground">
          <a href="mailto:joel@cycaslabs.com" class="hover:text-headings transition-colors">joel@cycaslabs.com</a>
          <a href="https://github.com/xceejay" class="hover:text-headings transition-colors">github.com/xceejay</a>
          <a href="https://bsky.app/profile/iohel.com" class="hover:text-headings transition-colors">bsky.app/profile/iohel.com</a>
        </div>
      </div>

    </div>
  </Container>
</BaseLayout>
