---
import { getCollection, getEntry } from 'astro:content';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/utils';

const entry = await getEntry('pages', 'archive');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout seo={entry.data.seo}>
  <Container as='section' class='py-6'>
    <div class="flex flex-col gap-6">
      <span class="text-headings text-4xl">Archive</span>
      <ul class="flex flex-col gap-3 text-xl">
        {posts.map((post) => (
          <li class="py-2">
            <div class="flex gap-5">
              <div class="relative min-w-22 shrink-0">
                <span class="text-muted-foreground text-xl">{formatDate(post.data.pubDate)}</span>
              </div>
              <a href={`/blog/${post.id}/`} class="flex flex-col gap-3">
                <div class="flex flex-col">
                  <span class="text-headings font-medium">{post.data.title}</span>
                  <span class="text-muted-foreground">{post.data.description}</span>
                </div>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</BaseLayout>
