---
import { getCollection, getEntry } from 'astro:content';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/utils';

const entry = await getEntry('pages', 'archive');

// Pull from every collection
const blogPosts = await getCollection('blog');
const notes = await getCollection('posts');
const projects = await getCollection('project-posts');
const jobs = await getCollection('jobs');
const talks = await getCollection('talks');

// Normalize everything into one timeline
type ArchiveItem = {
  type: string;
  title: string;
  date: Date;
  url?: string;
  subtitle?: string;
};

const items: ArchiveItem[] = [
  ...blogPosts.map(p => ({
    type: 'old post',
    title: p.data.title,
    date: p.data.pubDate,
    url: `/blog/${p.id}/`,
  })),
  ...notes.map(p => ({
    type: 'note',
    title: p.data.title,
    date: p.data.date,
    url: `/writing/${p.id}/`,
  })),
  ...projects.map(p => ({
    type: 'project',
    title: p.data.title,
    date: p.data.date,
    url: `/projects/${p.id}/`,
  })),
  ...jobs.map(j => ({
    type: 'work',
    title: `${j.data.title} at ${j.data.company}`,
    date: new Date(`${j.data.from}-01-01`),
    url: j.data.url,
    subtitle: `${j.data.location}`,
  })),
  ...talks.map(t => ({
    type: 'talk',
    title: t.data.title,
    date: new Date(`${t.data.year}-01-01`),
    url: t.data.url,
    subtitle: `${t.data.event}, ${t.data.location}`,
  })),
];

// Sort newest first
items.sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<BaseLayout seo={entry.data.seo}>
  <Container as='section' class='py-6'>
  </Container>
  <Container as='section' class='py-6'>
    <div class="flex flex-col gap-6">
      <span class="text-headings text-4xl">Archive</span>
      <ul class="flex flex-col gap-3 text-xl">
        {items.map((item) => (
          <li class="py-2">
            <div class="flex gap-5">
              <div class="relative min-w-22 shrink-0">
                <span class="text-muted-foreground text-xl">{formatDate(item.date)}</span>
              </div>
              <div class="flex flex-col">
                {item.url ? (
                  <a href={item.url} class="flex flex-col">
                    <span class="text-headings font-medium">{item.title}</span>
                    <span class="text-muted-foreground">{item.type}{item.subtitle ? ` · ${item.subtitle}` : ''}</span>
                  </a>
                ) : (
                  <div class="flex flex-col">
                    <span class="text-headings font-medium">{item.title}</span>
                    <span class="text-muted-foreground">{item.type}{item.subtitle ? ` · ${item.subtitle}` : ''}</span>
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</BaseLayout>
