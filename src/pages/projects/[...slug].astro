---
import Container from '@/components/Container.astro';
import Avatar from '@/components/ui/Avatar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('project-posts');

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "datePublished": entry.data.date.toISOString(),
  "dateModified": entry.data.date.toISOString(),
  "author": {
    "@type": "Person",
    "name": DEFAULT_CONFIGURATION.author.name,
    "url": "https://iohel.com"
  },
  "publisher": {
    "@type": "Person",
    "name": DEFAULT_CONFIGURATION.author.name,
    "url": "https://iohel.com"
  },
  ...(entry.data.image ? { "image": `https://iohel.com${entry.data.image.src}` } : {}),
  "description": entry.data.seo?.description || entry.data.title,
  "url": `https://iohel.com/projects/${entry.id}/`
});
---

<BaseLayout seo={{ ...entry.data.seo, image: entry.data.image || entry.data.seo?.image }}>
  <Container as='section'>
    <article class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <a href="/projects" class="transition-all text-muted-foreground hover:text-foreground pb-4 text-xl w-max">
          Back to my work
        </a>
        <div class="flex flex-col gap-1.5">
          <Avatar />
          <span class="text-foreground">{DEFAULT_CONFIGURATION.author.name}</span>
        </div>
        <h1 class="text-3xl font-semibold text-headings font-serif">{entry.data.title}</h1>
      </div>
      {entry.data.image && (
        <div class="relative aspect-video overflow-hidden rounded-lg">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            class="object-cover"
          />
        </div>
      )}
      <div class="prose dark:prose-invert max-w-none">
        <Content />
      </div>
    </article>
    <Fragment set:html={`<script type="application/ld+json">${articleJsonLd}</script>`} />
  </Container>
</BaseLayout>
  
