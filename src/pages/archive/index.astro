---
import { execSync } from 'child_process';
import type { ImageMetadata } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/utils';

const entry = await getEntry('pages', 'archive');

// Pull from every collection

const notes = await getCollection('posts');
const projects = await getCollection('project-posts');
const jobs = await getCollection('jobs');
const talks = await getCollection('talks');

// Photos with git first-commit dates
const photoGlob = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/photos/*.{jpg,jpeg,png,webp,avif}'
);

const photoItems = await Promise.all(
  Object.entries(photoGlob).map(async ([path, mod]) => {
    const { default: imageData } = await mod();
    const filename = path.split('/').pop() ?? '';
    const repoPath = `src/content/photos/${filename}`;
    let date: Date;
    try {
      const gitDate = execSync(
        `git log --follow --format="%ai" -- "${repoPath}" | tail -1`,
        { cwd: process.cwd() }
      ).toString().trim();
      date = gitDate ? new Date(gitDate) : new Date();
    } catch {
      date = new Date();
    }
    const name = filename.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ');
    return {
      type: 'photo',
      title: name.replace(/\b\w/g, c => c.toUpperCase()),
      date,
      url: '/photography',
      thumbnail: imageData.src,
    };
  })
);

// Normalize everything into one timeline
type ArchiveItem = {
  type: string;
  title: string;
  date: Date;
  url?: string;
  subtitle?: string;
  thumbnail?: string;
};

const items: ArchiveItem[] = [

  ...notes.map(p => ({
    type: 'note',
    title: p.data.title,
    date: p.data.date,
    url: `/writing/${p.id}/`,
    thumbnail: p.data.image?.src,
  })),
  ...projects.map(p => ({
    type: 'project',
    title: p.data.title,
    date: p.data.date,
    url: `/projects/${p.id}/`,
    thumbnail: p.data.image?.src,
  })),
  ...jobs.map(j => ({
    type: 'work',
    title: `${j.data.title} at ${j.data.company}`,
    date: new Date(`${j.data.from}-01-01`),
    url: j.data.url,
    subtitle: `${j.data.location}`,
  })),
  ...talks.map(t => ({
    type: 'talk',
    title: t.data.title,
    date: new Date(`${t.data.year}-01-01`),
    url: t.data.url,
    subtitle: `${t.data.event}, ${t.data.location}`,
  })),
  ...photoItems,
];

// Sort newest first
items.sort((a, b) => b.date.valueOf() - a.date.valueOf());

const tagColors: Record<string, string> = {
  note: 'bg-blue-200/40 text-blue-800 dark:bg-blue-800/30 dark:text-blue-300',
  project: 'bg-green-200/40 text-green-800 dark:bg-green-800/30 dark:text-green-300',
  work: 'bg-amber-200/40 text-amber-800 dark:bg-amber-800/30 dark:text-amber-300',
  talk: 'bg-purple-200/40 text-purple-800 dark:bg-purple-800/30 dark:text-purple-300',
  'old post': 'bg-rose-200/40 text-rose-800 dark:bg-rose-800/30 dark:text-rose-300',
  photo: 'bg-pink-200/40 text-pink-800 dark:bg-pink-800/30 dark:text-pink-300',
};
---

<BaseLayout seo={entry.data.seo}>
  <Container as='section' class='py-6'>
    <div class="flex flex-col gap-6">
      <span class="text-headings text-3xl">Archive</span>
      <ul class="flex flex-col gap-3 text-xl">
        {items.map((item) => (
          <li class="py-2">
            <div class="flex gap-5">
              <div class="relative min-w-22 shrink-0">
                <span class="text-muted-foreground text-xl">{formatDate(item.date)}</span>
              </div>
              <div class="flex flex-col">
                {item.url ? (
                  <a href={item.url} class="flex items-center gap-3">
                    {item.thumbnail ? (
                      <img src={item.thumbnail} alt={item.title} class="w-12 h-12 object-cover rounded-md shrink-0" />
                    ) : (
                      <div class={`w-12 h-12 rounded-md shrink-0 flex items-center justify-center text-sm font-bold ${tagColors[item.type] || ''}`}>
                        {item.type.charAt(0).toUpperCase()}
                      </div>
                    )}
                    <div class="flex flex-col">
                      <span class="text-headings font-medium">{item.title}</span>
                      <span class="flex items-center gap-2 text-muted-foreground">
                        <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${tagColors[item.type] || ''}`}>{item.type}</span>
                        {item.subtitle && <span>{item.subtitle}</span>}
                      </span>
                    </div>
                  </a>
                ) : (
                  <div class="flex items-center gap-3">
                    <div class={`w-12 h-12 rounded-md shrink-0 flex items-center justify-center text-sm font-bold ${tagColors[item.type] || ''}`}>
                      {item.type.charAt(0).toUpperCase()}
                    </div>
                    <div class="flex flex-col">
                      <span class="text-headings font-medium">{item.title}</span>
                      <span class="flex items-center gap-2 text-muted-foreground">
                        <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${tagColors[item.type] || ''}`}>{item.type}</span>
                        {item.subtitle && <span>{item.subtitle}</span>}
                      </span>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</BaseLayout>
