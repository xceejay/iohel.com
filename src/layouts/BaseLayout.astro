---
import '@/styles/global.css';
import '@/assets/fonts/Grenze/grenze.css';
import { type Seo } from '@/lib/constants';
import Header from '@/components/partials/Header.astro';
import Footer from '@/components/partials/Footer.astro';
import Head from '@/components/partials/Head.astro';
import SwitchTheme from '@/components/SwitchTheme.astro';

interface Props {
  seo?: Seo
}

const { seo } = Astro.props;
---

<html lang="en">
  <Head seo={seo} />
  <body class="bg-background text-foreground pb-12">
    <Header />
    <main class="pt-16">
      <slot />
    </main>
    <Footer />
    <SwitchTheme />
  </body>
</html>
